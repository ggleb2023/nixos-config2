;;;-*- lexical-binding: t; -*-
;; init.el

(setq inhibit-startup-screen-mode t)
(setq inhibit-startup-screen t)

(modify-frame-parameters nil '((undecorated . t)))
(when (fboundp 'menu-bar-mode)   (menu-bar-mode -1))
(when (fboundp 'tool-bar-mode)   (tool-bar-mode -1))
(when (fboundp 'scroll-bar-mode) (scroll-bar-mode -1))

(global-set-key (kbd "<f5>") (lambda () (interactive) (load user-init-file)))

;;font

(defun font-exists-p (font) (if (null (x-list-fonts font)) nil t))
(when (window-system)
  (cond ((font-exists-p "Iosevka") (set-frame-font "Iosevka:size=40" nil t))
    ((font-exists-p "Iosevka") (set-frame-font "Iosevka:size=40" nil t))))

(global-display-line-numbers-mode t)
(column-number-mode t)
(setq-default indent-tabs-mode nil)

;; package thingies

(require 'package)
(setq package-archives '(("gnu"    . "https://elpa.gnu.org/packages/")
                         ("nongnu" . "https://elpa.nongnu.org/packages/")
                         ("melpa"  . "https://melpa.org/packages/")))
(package-initialize)

(unless package-archive-contents
  (package-refresh-contents))

;;theme
(use-package yotsuba-theme
  :vc (:url "https://github.com/Senka07/yotsuba-emacs-theme")
  :config
  (load-theme 'yotsuba t))

(setq select-enable-clipboard t)

(when (executable-find "wl-copy")
  (setq interprogram-cut-function
        (lambda (text)
          (let ((process-connection-type nil))
            (call-process "wl-copy" nil nil nil text))))
  (setq interprogram-paste-function
        (lambda ()
          (shell-command-to-string "wl-paste -n"))))

(when (and (not (executable-find "wl-copy")) (executable-find "xclip"))
  (setq interprogram-cut-function
        (lambda (text)
          (let ((process-connection-type nil))
            (call-process "xclip" nil nil nil "-selection" "clipboard" text))))
  (setq interprogram-paste-function
        (lambda ()          (shell-command-to-string "xclip -o -selection clipboard"))))

(use-package envrc
  :hook (after-init . envrc-global-mode)
  :config
  (define-key envrc-mode-map (kbd "C-c e") envrc-command-map))
 
